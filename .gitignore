# Data and model publication boundary
# Local data has not been cleared for redistribution.
/data/
*.csv
*.parquet
*.feather

# Default-deny artifacts, runtime metadata and empirical priors.
# Only these aggregate evaluation reports are publication candidates.
/models/*
!/models/hist_gradient_boosting_metrics.json
!/models/logistic_backtest_metrics.json
!/models/logistic_baseline_metrics.json
!/models/logistic_enriched_symmetric_metrics.json
!/models/logistic_symmetric_metrics.json
!/models/method_backtest_metrics.json
!/models/round_backtest_metrics.json
!/models/v2_winner_backtest_metrics.json

